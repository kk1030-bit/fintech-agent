# 環境變數（絕對不能上傳，內含 API 金鑰）
.env
.env.*

# Python 快取
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Jupyter Notebook 快取
.ipynb_checkpoints/
*.ipynb

# 資料檔案（太大，不放 GitHub）
*.csv
*.pdf
*.xlsx
*.json
output/charts/*.png
output/web_dashboard_preview.png

# 虛擬環境
.venv/
venv/
env/
*.egg-info/

# 系統檔案
.DS_Store
Thumbs.db

# VS Code 設定
.vscode/
*.code-workspace

# Anaconda / Conda
*.conda

# V1.2 契約、交接與手冊資料需要進版控（覆蓋上面的 *.json / *.csv）
!contracts/*.json
!handoff/*.json
!docs/**/*.csv
# 本機 job 佇列資料庫
*.sqlite3
# 手冊指定的組員交付路徑（json/csv 必須進版控，否則會被上面的 *.json / *.csv 靜默略過）
!data/**/*.json
!data/**/*.csv
!fixtures/**/*.json
!evaluation/**/*.json
!evaluation/**/*.csv
!agent/**/*.json
!research/**/*.json
!release/**/*.json
!ui/**/*.json
!publication/**/*.json
!operations/**/*.json
